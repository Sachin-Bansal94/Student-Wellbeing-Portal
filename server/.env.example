NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wellbeing

# Dedicated database for `npm run verify`. REQUIRED to run the suite: it truncates appointments
# and creates counsellor records, which are publicly listed, so it must never point at the
# application database. The suite refuses to start if this is unset or equal to DATABASE_URL.
# Prepare it once with `npm run migrate:test` then `npm run seed:test`.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wellbeing_test

CLIENT_ORIGIN=http://localhost:5173

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=iitism.ac.in

# Authoritative, operator-controlled admin allowlist (comma-separated @iitism.ac.in addresses).
# The server grants admin authority because the authenticated email appears here; users can
# never self-assign. Removing an address revokes admin immediately, even if the database row
# still says 'admin'. Leave blank for no admins.
ADMIN_EMAILS=

# Local testing only. Signs in any @iitism.ac.in address with no password.
# The server refuses to start if this is true while NODE_ENV=production.
ALLOW_DEV_LOGIN=false

JWT_SECRET=replace-with-a-long-random-string
CONFIRMATION_TOKEN_SECRET=replace-with-another-long-random-string
AUTH_TOKEN_SECRET=replace-with-yet-another-long-random-string

# Email. Pick ONE way to send, or leave all blank in development (links are printed to the server console).
#
# Option A, SMTP (simplest for a college project). Works for any recipient, for example a Gmail
# account with 2 step verification and an app password: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16 character app password>. Port 465 needs SMTP_SECURE=true.
# MAIL_FROM should be the same address as SMTP_USER for Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Option B, Resend. Only delivers to any address after you verify a sending domain in Resend.
# Used only when SMTP_HOST is blank.
RESEND_API_KEY=

MAIL_FROM=IIT ISM Wellbeing <wellbeing@example.com>

SLOT_MINUTES=20
MIN_BOOKING_LEAD_MINUTES=60
PENDING_EXPIRY_MINUTES=10
CANCELLATION_CUTOFF_HOURS=4
BOOKING_HORIZON_DAYS=14
EMAIL_VERIFICATION_EXPIRY_MINUTES=1440
PASSWORD_RESET_EXPIRY_MINUTES=60
